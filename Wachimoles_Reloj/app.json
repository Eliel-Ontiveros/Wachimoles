{
  "configVersion": "v3",
  "app": {
    "appId": 1135502,
    "appName": "WachiMoles Health Test",
    "appType": "app",
    "version": {
      "code": 28,
      "name": "0.5.2"
    },
    "icon": "icon.png",
    "vender": "WachiMoles",
    "description": "Prueba de lectura y envío de ritmo cardíaco y estrés"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "4.0.0",
      "target": "4.0.0",
      "minVersion": "4.0.0"
    }
  },
  "permissions": [
    "data:os.device.info",
    "device:os.bg_service",
    "device:os.alarm",
    "data:user.hd.heart_rate",
    "data:user.hd.stress",
    "data:user.hd.step",
    "data:user.hd.spo2"
  ],
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/watchdog"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "app-service": {
          "services": [
            "app-service/health_monitor",
            "app-service/health_watchdog"
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "es-ES": {
      "appName": "WachiMoles Health Test"
    }
  },
  "defaultLanguage": "es-ES"
}