    "version": {
      "code": 15,
      "name": "0.3.2"
    },
    "icon": "icon.png",
    "vender": "WachiMoles",
    "description": "Prueba de lectura y envío de ritmo cardíaco y estrés"
  },
  "runtime": {
    "apiVersion": {
      "compatible": "2.1.0",
      "target": "2.1.0",
